# Women's WhatsApp line. Until set, /contact shows ONE general channel rather
# than mislabelling a single number as two gendered ones (see README.md).
NEXT_PUBLIC_WHATSAPP_WOMEN=

# Men's / general WhatsApp. Defaults to the published number.
NEXT_PUBLIC_WHATSAPP_MEN=966539065696

# In-Kingdom waitlist store. Leave unset until hosting residency is decided —
# this data can include minors' details (Saudi PDPL). See docs/18 §3.
WAITLIST_ENDPOINT=
WAITLIST_TOKEN=
